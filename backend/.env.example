# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wacc?schema=public"

# --- App ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:3000"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_TTL="7d"

# --- Seed (dev only) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- WaSenderAPI (fill in from your WaSenderAPI account) ---
# NOTE: exact endpoint paths/auth scheme must be verified against current
# WaSenderAPI docs before Stage 2 (WhatsApp Integration) is implemented.
WASENDER_API_BASE_URL="https://REPLACE_ME"
WASENDER_API_KEY="replace-with-wasender-api-key"
WASENDER_WEBHOOK_SECRET="replace-with-wasender-webhook-secret"

# --- n8n ---
N8N_WEBHOOK_URL="https://REPLACE_ME/webhook/whatsapp-automation"
N8N_SERVICE_TOKEN="replace-with-shared-service-token-for-n8n-callbacks"

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=20
